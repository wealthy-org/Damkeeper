{
  "name": "damkeeper",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=apps/web",
    "cli": "npm run start --workspace=packages/cli --",
    "cli:link": "npm link --workspace=packages/cli",
    "cli:build": "npm run build --workspace=packages/cli",
    "cli:test": "npm run test --workspace=packages/cli",
    "showcase": "tsx scripts/run.ts",
    "showcase:vesting": "tsx scripts/vesting.ts",
    "db:generate": "npm run db:generate --workspace=apps/web",
    "db:migrate": "npm run db:migrate --workspace=apps/web",
    "contracts:build": "cd packages/contracts && forge build",
    "contracts:test": "cd packages/contracts && forge test -vvv"
  }
}
