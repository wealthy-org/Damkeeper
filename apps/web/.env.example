# Neon Postgres — free tier at https://neon.tech. Use the pooled connection string.
DATABASE_URL="postgresql://user:password@ep-xxxx.neon.tech/damkeeper?sslmode=require"

# RPC endpoints. Leave unset to fall back to the free public Blockscout JSON-RPC
# passthrough in lib/chains.ts (rate-limited, fine for dev). For production, get a
# free-tier key from Alchemy (https://alchemy.com) or another provider and set these.
NEXT_PUBLIC_TESTNET_RPC_URL=""
NEXT_PUBLIC_MAINNET_RPC_URL=""

# Deployed manager addresses. Leave blank until packages/config manifest is filled in
# with real, verified deployment data — never guess an address.
NEXT_PUBLIC_LOCK_MANAGER_ADDRESS=""
NEXT_PUBLIC_VESTING_MANAGER_ADDRESS=""

# Shared secret so /api/cron/index can't be triggered by randoms if you're not using
# Vercel's own signed cron invocation.
CRON_SECRET=""
